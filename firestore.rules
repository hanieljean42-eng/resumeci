rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Waitlist: create public, lecture autorisée pour les admins authentifiés
    match /waitlist/{document} {
      allow create: if true;
      allow read: if request.auth != null;
      allow update, delete: if request.auth != null;
    }

    // Utilisateurs et Inscriptions: création/mise à jour, lecture pour admins authentifiés
    match /users/{userId} {
      allow create, update: if true;
      allow read: if request.auth != null;
    }

    match /inscriptions/{userId} {
      allow create, update: if true;
      allow read: if request.auth != null;
    }

    // Bloquer le reste par défaut
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
