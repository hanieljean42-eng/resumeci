rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Waitlist: création et lecture
    match /waitlist/{document} {
      allow read, write: if true;
    }

    // Utilisateurs et Inscriptions: lecture et écriture publiques (auth par numéro/mdp géré côté application)
    match /users/{userId} {
      allow read, write: if true;
    }

    match /inscriptions/{userId} {
      allow read, write: if true;
    }

    // Bloquer le reste par défaut
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
