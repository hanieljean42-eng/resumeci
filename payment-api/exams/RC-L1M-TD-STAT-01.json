{
  "code": "RC-L1M-TD-STAT-01",
  "format": "exam-v2",
  "titre": "Examen chronométré — Statistique descriptive",
  "classe": "Licence_1_Miage",
  "classeLabel": "Licence 1 MIAGE",
  "matiere": "Statistiques descriptive",
  "dureeMin": 60,
  "noteSur": 20,
  "consignes": "Mode Examen : réponds directement dans l'application avant la fin du chrono. Écris les décimaux avec une virgule (ex : 12,5).",
  "params": {
    "x1": { "choices": [10, 12, 8] },
    "x2": { "choices": [14, 12] },
    "x3": { "choices": [16, 18, 15] },
    "eff": { "choices": [4, 5, 6] },
    "aa": { "choices": [2, 3] },
    "bb": { "choices": [1, 5] },
    "xp": { "choices": [6, 8, 10] }
  },
  "derived": {
    "moy": "(x1+x2+x3)/3",
    "var1": "((x1-(x1+x2+x3)/3)*(x1-(x1+x2+x3)/3) + (x2-(x1+x2+x3)/3)*(x2-(x1+x2+x3)/3) + (x3-(x1+x2+x3)/3)*(x3-(x1+x2+x3)/3))/3",
    "tot": "eff*moy",
    "yp": "aa*xp+bb",
    "somme": "x1+x2+x3"
  },
  "blocs": [
    {
      "titre": "Exercice 1 — Mesures centrales",
      "consigne": "On relève les notes de 3 étudiants : {{x1}}, {{x2}}, {{x3}}.",
      "questions": [
        {
          "id": "e1q1",
          "type": "numeric",
          "points": 3,
          "chapitre": "Moyenne",
          "enonce": "Calcule la moyenne de la série {{x1}}, {{x2}}, {{x3}}.",
          "answer": "(x1+x2+x3)/3",
          "tol": 0.01,
          "corrige": "$\\bar{x}=\\frac{ {{x1}}+{{x2}}+{{x3}} }{3}=\\frac{ {{num:somme}} }{3}$ ≈ {{d2:moy}}."
        },
        {
          "id": "e1q2",
          "type": "qcm",
          "points": 3,
          "chapitre": "Médiane",
          "enonce": "La médiane de la série ordonnée 4, 7, 9, 12, 15 est :",
          "choix": [
            "7",
            "9",
            "9,4",
            "12"
          ],
          "correct": 1,
          "corrige": "5 valeurs ordonnées → médiane = valeur centrale (3ᵉ) = 9. (La moyenne 9,4 est un piège.)"
        }
      ]
    },
    {
      "titre": "Exercice 2 — Dispersion et effectifs",
      "consigne": "Variance et effectif total.",
      "questions": [
        {
          "id": "e2q1",
          "type": "numeric",
          "points": 4,
          "chapitre": "Variance",
          "enonce": "Calcule la variance de la série {{x1}}, {{x2}}, {{x3}} (arrondi au centième).",
          "answer": "((x1-(x1+x2+x3)/3)*(x1-(x1+x2+x3)/3) + (x2-(x1+x2+x3)/3)*(x2-(x1+x2+x3)/3) + (x3-(x1+x2+x3)/3)*(x3-(x1+x2+x3)/3))/3",
          "tol": 0.05,
          "corrige": "$V=\\frac{1}{3}\\sum (x_i-\\bar{x})^{2}$ avec $\\bar{x}$≈{{d2:moy}} → $V$ ≈ {{d2:var1}}."
        },
        {
          "id": "e2q2",
          "type": "numeric",
          "points": 3,
          "chapitre": "Effectifs",
          "enonce": "Un groupe de {{eff}} étudiants a la même moyenne {{d2:moy}}. Quelle est la somme totale de leurs notes ?",
          "answer": "eff*(x1+x2+x3)/3",
          "tol": 0.5,
          "corrige": "Somme $=$ moyenne $\\times$ effectif $= {{d2:moy}}\\times{{eff}}$ ≈ {{num:tot}}."
        },
        {
          "id": "e2q3",
          "type": "vrai_faux",
          "points": 2,
          "chapitre": "Variance",
          "enonce": "La variance d'une série peut être négative.",
          "correct": false,
          "corrige": "<strong>Faux.</strong> La variance est une moyenne de carrés : elle est toujours $\\geq 0$ (nulle seulement si toutes les valeurs sont identiques)."
        }
      ]
    },
    {
      "titre": "Exercice 3 — Régression linéaire",
      "consigne": "La droite d'ajustement est $\\hat{y}={{aa}}x+{{bb}}$.",
      "questions": [
        {
          "id": "e3q1",
          "type": "numeric",
          "points": 3,
          "chapitre": "Régression",
          "enonce": "Avec $\\hat{y}={{aa}}x+{{bb}}$, prévois $y$ pour $x={{xp}}$.",
          "answer": "aa*xp+bb",
          "tol": 0.001,
          "corrige": "$\\hat{y}={{aa}}\\times{{xp}}+{{bb}}={{num:yp}}$."
        },
        {
          "id": "e3q2",
          "type": "qcm",
          "points": 2,
          "chapitre": "Corrélation",
          "enonce": "Un coefficient de corrélation $r=-0{,}95$ indique :",
          "choix": [
            "une forte liaison linéaire croissante",
            "une forte liaison linéaire décroissante",
            "aucune liaison",
            "une erreur de calcul car $r$ ne peut pas être négatif"
          ],
          "correct": 1,
          "corrige": "$r$ proche de $-1$ → forte corrélation linéaire négative (quand $x$ augmente, $y$ diminue)."
        }
      ]
    }
  ]
}
