  "params": {
    "a": { "choices": [2, 3, 4] },
    "c": { "choices": [1, 3, 5] },
    "x0": { "choices": [1, 2] }
  },
  "derived": {
    "a2": "a*a",
    "lim1": "a*2",
    "der": "2*a*x0+c",
