    {
      "titre": "Exercice 2 — QCM",
      "consigne": "Une seule réponse exacte par question.",
      "questions": [
        {
          "id": "e2q1", "type": "qcm", "points": 1, "chapitre": "Exponentielle",
          "enonce": "Les solutions de $\\mathrm{e}^{2x} - 3\\mathrm{e}^{x} + 2 = 0$ sont",
          "choix": ["$x=0$ et $x=\\ln 2$", "$x=1$ et $x=2$", "$x=\\ln 3$ uniquement"],
          "correct": 0,
          "corrige": "<strong>Réponse a.</strong> Poser $X=\\mathrm{e}^x$ : $X^2-3X+2=0$ donne $X=1$ ou $X=2$, soit $x=0$ ou $x=\\ln 2$."
        },
        {
          "id": "e2q2", "type": "qcm", "points": 1, "chapitre": "Isométries",
          "enonce": "L'image du point $B({{bb}}\\,;\\,1)$ par la rotation de centre $O$ et d'angle $\\frac{\\pi}{2}$ a pour affixe",
          "choix": ["$-1+{{bb}}\\mathrm{i}$", "$1-{{bb}}\\mathrm{i}$", "${{bb}}+\\mathrm{i}$"],
          "correct": 0,
          "corrige": "<strong>Réponse a.</strong> Rotation $\\frac{\\pi}{2}$ : $z'=\\mathrm{i}z=\\mathrm{i}({{bb}}+\\mathrm{i})=-1+{{bb}}\\mathrm{i}$, point $(-1\\,;\\,{{bb}})$."
        },
        {
          "id": "e2q3", "type": "qcm", "points": 1, "chapitre": "Exponentielle",
          "enonce": "Le minimum de $f(x)=x\\,\\mathrm{e}^{x}$ sur $\\mathbb{R}$ est atteint en",
          "choix": ["$x=-1$", "$x=0$", "$x=1$"],
          "correct": 0,
          "corrige": "<strong>Réponse a.</strong> $f'(x)=\\mathrm{e}^x(x+1)$ s'annule en $x=-1$ : minimum $f(-1)=-\\frac{1}{\\mathrm{e}}$."
        }
      ]
    },
