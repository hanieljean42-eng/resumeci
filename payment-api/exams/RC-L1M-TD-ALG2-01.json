  "blocs": [
    {
      "titre": "Exercice 1 — Déterminants",
      "consigne": "Calcule les déterminants demandés.",
      "questions": [
        {
          "id": "e1q1",
          "type": "numeric",
          "points": 3,
          "chapitre": "Déterminant 2×2",
          "enonce": "Calcule $\\det\\begin{pmatrix} {{a}} & {{b}} \\\\ {{c}} & {{d}} \\end{pmatrix}$.",
          "answer": "a*d - b*c",
          "tol": 0.001,
          "corrige": "$\\det = {{a}}\\times{{d}} - {{b}}\\times{{c}} = {{num:det1}}$."
        },
        {
          "id": "e1q2",
          "type": "numeric",
          "points": 4,
          "chapitre": "Règle de Sarrus",
          "enonce": "Calcule par la règle de Sarrus : $\\det\\begin{pmatrix} 1 & 2 & 0 \\\\ 3 & 1 & 2 \\\\ 0 & 1 & 1 \\end{pmatrix}$.",
          "answer": "-7",
          "tol": 0.001,
          "corrige": "Sarrus : $(1\\times1\\times1 + 2\\times2\\times0 + 0\\times3\\times1) - (0\\times1\\times0 + 2\\times3\\times1 + 1\\times2\\times1) = 1 - 8 = -7$."
        }
      ]
    },
    {
      "titre": "Exercice 2 — Produit de matrices et propriétés",
      "consigne": "Produit matriciel et propriétés des déterminants.",
      "questions": [
        {
          "id": "e2q1",
          "type": "numeric",
          "points": 3,
          "chapitre": "Produit matriciel",
          "enonce": "Soient $A=\\begin{pmatrix} {{a}} & {{b}} \\\\ {{c}} & {{d}} \\end{pmatrix}$ et $B=\\begin{pmatrix} {{p}} & {{q}} \\\\ {{r}} & {{s}} \\end{pmatrix}$. Quelle est la valeur du coefficient $(AB)_{1,2}$ ?",
          "precision": "Coefficient ligne 1, colonne 2 du produit.",
          "answer": "a*q + b*s",
          "tol": 0.001,
          "corrige": "$(AB)_{1,2} = {{a}}\\times{{q}} + {{b}}\\times{{s}} = {{num:prod12}}$."
        },
        {
          "id": "e2q2",
          "type": "vrai_faux",
          "points": 2,
          "chapitre": "Propriétés",
          "enonce": "Pour toutes matrices carrées $A$ et $B$ de même taille : $\\det(AB)=\\det(A)\\times\\det(B)$.",
          "correct": true,
          "corrige": "<strong>Vrai.</strong> Le déterminant est multiplicatif : propriété fondamentale."
        },
        {
          "id": "e2q3",
          "type": "vrai_faux",
          "points": 2,
          "chapitre": "Propriétés",
          "enonce": "Le produit de matrices est commutatif : $AB=BA$ pour toutes matrices.",
          "correct": false,
          "corrige": "<strong>Faux.</strong> En général $AB\\neq BA$ : le produit matriciel n'est pas commutatif."
        }
      ]
    },
    {
      "titre": "Exercice 3 — Systèmes et inversibilité",
      "consigne": "Méthode de Cramer et condition d'inversibilité.",
      "questions": [
        {
          "id": "e3q1",
          "type": "qcm",
          "points": 3,
          "chapitre": "Inversibilité",
          "enonce": "Une matrice carrée $M$ est inversible si et seulement si :",
          "choix": [
            "tous ses coefficients sont non nuls",
            "$\\det(M)\\neq 0$",
            "$\\det(M)=0$",
            "elle est symétrique"
          ],
          "correct": 1,
          "corrige": "$M$ inversible $\\iff \\det(M)\\neq0$ ; alors $M^{-1}=\\frac{1}{\\det M}\\,{}^{t}\\mathrm{com}(M)$."
        },
        {
          "id": "e3q2",
          "type": "numeric",
          "points": 3,
          "chapitre": "Système de Cramer",
          "enonce": "Résous le système $\\begin{cases} x + y = {{p}} \\\\ 2x - y = {{r}} \\end{cases}$ — donne la valeur de $x$.",
          "answer": "(p+r)/3",
          "tol": 0.001,
          "corrige": "En ajoutant les deux équations : $3x={{p}}+{{r}}$ → $x={{num:xcr}}$."
        }
      ]
    }
  ]
}
